<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  GRETTA add-in-only manifest (DECISIONS.md ADR-001).
  Baseline requirement: WordApi 1.3 (ARCHITECTURE.md §3.5). Comments (WordApi 1.4)
  are feature-detected at runtime, never required here.
  URLs point at the dev server (https://localhost:3000); a production copy of this
  file with hosted URLs is produced at distribution time (ADR-009).
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <Id>0a1d1e0b-8bf7-4b1d-b07b-6bcdc8d1f307</Id>
  <Version>0.1.0</Version>
  <ProviderName>GRETTA</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="GRETTA" />
  <Description DefaultValue="Generative Research Engine for Technical Text Authoring. Local-first AI writing assistance for scientific and technical documents, powered entirely by your own Ollama instance." />
  <IconUrl DefaultValue="https://localhost:3000/assets/gretta-icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/gretta-icon-64.png" />
  <SupportUrl DefaultValue="https://github.com/WilliamKMLai/gretta/issues" />

  <!--
    Scholarly APIs reached by literature search (DECISIONS.md ADR-028). Declared
    even though every source ships off: AppDomains is a static manifest element
    and cannot express a per-source toggle, so it bounds the blast radius to a
    known host list while the toggles in Settings decide what is actually
    contacted. The toggle is the security control; this is the backstop.
  -->
  <AppDomains>
    <AppDomain>https://api.crossref.org</AppDomain>
    <AppDomain>https://api.openalex.org</AppDomain>
    <AppDomain>https://eutils.ncbi.nlm.nih.gov</AppDomain>
    <AppDomain>https://export.arxiv.org</AppDomain>
    <AppDomain>https://api.biorxiv.org</AppDomain>
    <AppDomain>https://doi.org</AppDomain>
    <AppDomain>https://pubmed.ncbi.nlm.nih.gov</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="WordApi" MinVersion="1.3" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="GRETTA.Group">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="GRETTA.OpenTaskpane">
                  <Label resid="Button.Label" />
                  <Supertip>
                    <Title resid="Button.Label" />
                    <Description resid="Button.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>GRETTA.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:3000/assets/gretta-icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:3000/assets/gretta-icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:3000/assets/gretta-icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3000/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="GRETTA" />
        <bt:String id="Button.Label" DefaultValue="Open GRETTA" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Tooltip" DefaultValue="Open the GRETTA task pane — a local AI writing assistant powered by Ollama." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
