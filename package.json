{
  "name": "gretta",
  "private": true,
  "version": "1.0.0",
  "description": "Local AI writing assistant for Microsoft Word, powered entirely by Ollama.",
  "license": "MIT",
  "author": "WilliamKMLai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilliamKMLai/gretta.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "dev:mac": "node scripts/dev-mac.mjs",
    "dev:web": "vite --mode browser",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "validate:manifest": "office-addin-manifest validate manifest/manifest.xml",
    "proxy": "node scripts/ollama-https-proxy.mjs",
    "kb": "node --experimental-strip-types scripts/kb/server.mts",
    "certs:install": "office-addin-dev-certs install",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "smoke:boot": "node scripts/boot-smoke.mjs",
    "smoke:lit": "GRETTA_LIVE_SMOKE=1 vitest run --config vitest.smoke.config.ts",
    "test:kb-native": "vitest run --config vitest.kb-native.config.ts"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.60.0",
    "@fluentui/react-icons": "^2.0.333",
    "@hookform/resolvers": "^5.0.0",
    "@napi-rs/canvas": "^1.0.5",
    "@tanstack/react-query": "^5.66.0",
    "better-sqlite3": "^13.0.1",
    "fast-xml-parser": "^5.10.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "@types/office-js": "^1.0.500",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.7.0",
    "jsdom": "^26.0.0",
    "office-addin-dev-certs": "^2.0.0",
    "office-addin-manifest": "^2.0.0",
    "office-addin-mock": "^3.0.10",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
